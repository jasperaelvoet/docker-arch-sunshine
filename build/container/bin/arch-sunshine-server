#!/usr/bin/env python3
import argparse
import json
import os
import stat
import subprocess
import sys
import time
from pathlib import Path


USER_DATA = Path("/mnt/user_data")
CONFIG_DIR = USER_DATA / "etc" / "sunshine"
STATE_DIR = USER_DATA / "var" / "lib" / "sunshine"
LOG_DIR = USER_DATA / "var" / "log" / "arch-sunshine"
PIN_FIFO = STATE_DIR / "pin.fifo"
CONFIG_FILE = CONFIG_DIR / "sunshine.conf"
APPS_FILE = CONFIG_DIR / "apps.json"
WEB_UI_USER = os.environ.get("SUNSHINE_WEB_UI_USER", "sunshine")
WEB_UI_PASS = os.environ.get("SUNSHINE_WEB_UI_PASS", "sunshine")


def render_node():
    override = os.environ.get("SUNSHINE_ADAPTER", "").strip()
    if override:
        return override
    nodes = sorted(Path("/dev/dri").glob("renderD*"))
    return str(nodes[0]) if nodes else ""


def config_lines():
    capture = os.environ.get("SUNSHINE_CAPTURE", "kwin").strip()
    if capture.lower() == "auto":
        capture = ""
    encoder = os.environ.get("SUNSHINE_ENCODER", "").strip()
    display = os.environ.get("SUNSHINE_DISPLAY", "").strip()
    adapter = render_node()

    lines = [
        "sunshine_name = Docker Arch Sunshine",
        "min_log_level = info",
        f"log_path = {LOG_DIR / 'sunshine.log'}",
        f"file_state = {STATE_DIR / 'sunshine_state.json'}",
        f"credentials_file = {STATE_DIR / 'sunshine_state.json'}",
        f"pkey = {STATE_DIR / 'sunshine.key'}",
        f"cert = {STATE_DIR / 'sunshine.crt'}",
        f"file_apps = {APPS_FILE}",
        "address_family = ipv4",
        "upnp = disabled",
        "origin_web_ui_allowed = wan",
        "lan_encryption_mode = 0",
        "wan_encryption_mode = 0",
        "system_tray = disabled",
        'global_prep_cmd = [{"do":"/usr/local/bin/arch-sunshine client-start","undo":"/usr/local/bin/arch-sunshine client-stop"}]',
        "stream_audio = enabled",
        "audio_sink = arch_sunshine_audio.monitor",
        "virtual_sink = arch_sunshine_audio",
        "gamepad = auto",
    ]
    if capture:
        lines.append(f"capture = {capture}")
    if encoder:
        lines.append(f"encoder = {encoder}")
    if display:
        lines.append(f"display_name = {display}")
    if adapter:
        lines.append(f"adapter_name = {adapter}")
    return lines


def apps_config():
    desktop_env = {
        "PATH": "$(PATH):$(HOME)/.local/bin",
        "LANG": "en_US.UTF-8",
        "LC_CTYPE": "en_US.UTF-8",
        "XDG_RUNTIME_DIR": os.environ.get("XDG_RUNTIME_DIR", "/run/user/1000"),
        "WAYLAND_DISPLAY": os.environ.get("WAYLAND_DISPLAY", "arch-sunshine-wayland"),
        "DISPLAY": os.environ.get("DISPLAY", os.environ.get("SUNSHINE_XWAYLAND_DISPLAY", ":0")),
        "XDG_SESSION_TYPE": "wayland",
        "XDG_CURRENT_DESKTOP": "KDE",
        "XDG_SESSION_DESKTOP": "KDE",
        "DESKTOP_SESSION": "plasma",
        "KDE_SESSION_VERSION": "6",
        "KDE_FULL_SESSION": "true",
        "QT_QPA_PLATFORM": "wayland",
        "SDL_VIDEODRIVER": "wayland,x11",
        "MOZ_ENABLE_WAYLAND": "1",
        "GIO_USE_NETWORK_MONITOR": "base",
        "RES_OPTIONS": "timeout:1 attempts:2 rotate single-request-reopen",
        "PULSE_SERVER": os.environ.get("PULSE_SERVER", "unix:/run/user/1000/pulse/native"),
        "STEAM_RUNTIME": "1",
        "SRT_URLOPEN_PREFER_STEAM": "1",
        "STEAM_DISABLE_AUDIO_DEVICE_SWITCHING": "1",
    }
    return {
        "env": desktop_env,
        "apps": [
            {
                "name": "Desktop",
                "image-path": "desktop.png",
            },
        ],
    }


def ensure_fifo(path):
    try:
        mode = path.stat().st_mode
        if stat.S_ISFIFO(mode):
            return
        path.unlink()
    except FileNotFoundError:
        pass
    os.mkfifo(path, 0o600)


def write_runtime_files():
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text("\n".join(config_lines()) + "\n", encoding="utf-8")
    APPS_FILE.write_text(json.dumps(apps_config(), indent=2) + "\n", encoding="utf-8")
    ensure_fifo(PIN_FIFO)


def seed_web_credentials():
    result = subprocess.run(
        ["/usr/local/bin/sunshine", str(CONFIG_FILE), "--creds", WEB_UI_USER, WEB_UI_PASS],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.returncode == 0


def serve():
    write_runtime_files()
    seed_web_credentials()
    fifo_reader = subprocess.Popen(
        ["/bin/sh", "-c", f"while true; do cat {PIN_FIFO}; done"],
        stdout=subprocess.PIPE,
    )
    try:
        sunshine = subprocess.Popen(
            ["/usr/local/bin/sunshine", "-0", str(CONFIG_FILE)],
            stdin=fifo_reader.stdout,
        )
        if fifo_reader.stdout:
            fifo_reader.stdout.close()
        return sunshine.wait()
    finally:
        fifo_reader.terminate()
        try:
            fifo_reader.wait(timeout=2)
        except subprocess.TimeoutExpired:
            fifo_reader.kill()


def stage_pin(pin):
    pin = pin.strip()
    if not (len(pin) == 4 and pin.isdigit()):
        print("PIN must be exactly 4 digits.", file=sys.stderr)
        return 2
    deadline = time.monotonic() + 30
    while not PIN_FIFO.exists():
        if time.monotonic() > deadline:
            print(f"Sunshine PIN FIFO is not ready: {PIN_FIFO}", file=sys.stderr)
            return 1
        time.sleep(0.1)
    with PIN_FIFO.open("w", encoding="utf-8") as handle:
        handle.write(pin + "\n")
    print("PIN sent to Sunshine.")
    return 0


def main():
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("serve")
    pin_parser = subparsers.add_parser("pin")
    pin_parser.add_argument("pin")
    args = parser.parse_args()

    if args.command == "serve":
        return serve()
    if args.command == "pin":
        return stage_pin(args.pin)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
