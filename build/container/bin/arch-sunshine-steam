#!/usr/bin/env bash
set -euo pipefail

STEAM_REAL="${ARCH_SUNSHINE_STEAM_REAL:-/usr/bin/steam}"
STEAM_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/Steam"
STEAM_BOOTSTRAP_TAR=/usr/share/arch-sunshine/steam/bootstraplinux_ubuntu12_32.tar.xz
STEAM_DEV_CFG="${HOME}/.steam/steam/steam_dev.cfg"

ensure_steam_bootstrap() {
  if [ -x "${STEAM_DIR}/steam.sh" ]; then
    return 0
  fi

  if [ ! -f "${STEAM_BOOTSTRAP_TAR}" ]; then
    return 0
  fi

  mkdir -p "${STEAM_DIR}"
  if ! tar -xJf "${STEAM_BOOTSTRAP_TAR}" -C "${STEAM_DIR}"; then
    [ -x "${STEAM_DIR}/steam.sh" ] || return 1
  fi
}

ensure_steam_links() {
  mkdir -p "${HOME}/.steam"
  ln -sfn "${STEAM_DIR}" "${HOME}/.steam/steam"
  ln -sfn "${STEAM_DIR}" "${HOME}/.steam/root"
  ln -sfn "${STEAM_DIR}/ubuntu12_32" "${HOME}/.steam/bin32"
  ln -sfn "${STEAM_DIR}/ubuntu12_64" "${HOME}/.steam/bin64"
  ln -sfn "${STEAM_DIR}/linux32" "${HOME}/.steam/sdk32"
  ln -sfn "${STEAM_DIR}/linux64" "${HOME}/.steam/sdk64"
  ln -sfn "${HOME}/.steam/bin32" "${HOME}/.steam/bin"
  rm -f "${HOME}/.steam/steam.pid" "${HOME}/.steam/steam.pipe" "${HOME}/.steam/steam.token"
}

configure_steam_defaults() {
  local threads

  mkdir -p "$(dirname "${STEAM_DEV_CFG}")" "${HOME}/.steam/root/config"
  touch "${HOME}/.steam/root/config/SteamAppData.vdf" || true

  if [ ! -f "${STEAM_DEV_CFG}" ] || ! grep -q '^unShaderBackgroundProcessingThreads ' "${STEAM_DEV_CFG}"; then
    threads=$(($(nproc) - 2))
    if [ "${threads}" -gt 16 ]; then
      threads=16
    elif [ "${threads}" -lt 1 ]; then
      threads=1
    fi
    printf 'unShaderBackgroundProcessingThreads %s\n' "${threads}" >> "${STEAM_DEV_CFG}"
  fi
}

clear_steam_offline_state() {
  local file

  for file in \
    "${STEAM_DIR}/config/loginusers.vdf" \
    "${STEAM_DIR}/config/config.vdf" \
    "${STEAM_DIR}/registry.vdf" \
    "${HOME}/.steam/registry.vdf"; do
    [ -f "${file}" ] || continue
    sed -i -E \
      -e 's/"WantsOfflineMode"[[:space:]]+"1"/"WantsOfflineMode"\t\t"0"/g' \
      -e 's/"SkipOfflineModeWarning"[[:space:]]+"1"/"SkipOfflineModeWarning"\t\t"0"/g' \
      -e 's/"Offline"[[:space:]]+"1"/"Offline"\t\t"0"/g' \
      -e 's/"ForceOfflineMode"[[:space:]]+"1"/"ForceOfflineMode"\t\t"0"/g' \
      "${file}"
  done
}

export STEAM_RUNTIME=1
export SRT_URLOPEN_PREFER_STEAM=1
export STEAM_DISABLE_AUDIO_DEVICE_SWITCHING=1
export GIO_USE_NETWORK_MONITOR=base
export RES_OPTIONS="timeout:1 attempts:2 rotate single-request-reopen"

ensure_steam_bootstrap
ensure_steam_links
configure_steam_defaults
clear_steam_offline_state

steam_args=("$@")
has_tcp=0
for arg in "${steam_args[@]}"; do
  if [ "${arg}" = "-tcp" ]; then
    has_tcp=1
    break
  fi
done
if [ "${has_tcp}" -eq 0 ]; then
  steam_args=(-tcp "${steam_args[@]}")
fi

exec "${STEAM_REAL}" "${steam_args[@]}"
