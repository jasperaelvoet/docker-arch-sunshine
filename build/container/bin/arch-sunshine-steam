#!/usr/bin/env bash
set -euo pipefail

export LANG="${LANG:-en_US.UTF-8}"
export LC_CTYPE="${LC_CTYPE:-en_US.UTF-8}"
export STEAM_RUNTIME="${STEAM_RUNTIME:-1}"
export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-x11}"
export LIBGL_DRI3_ENABLE="${LIBGL_DRI3_ENABLE:-1}"

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
  plasma_pid="$(pgrep -u "$(id -u)" -x plasmashell | head -n 1 || true)"
  if [ -n "${plasma_pid}" ] && [ -r "/proc/${plasma_pid}/environ" ]; then
    plasma_bus="$(
      tr '\0' '\n' < "/proc/${plasma_pid}/environ" \
        | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' \
        | head -n 1
    )"
    if [ -n "${plasma_bus}" ]; then
      export DBUS_SESSION_BUS_ADDRESS="${plasma_bus}"
    fi
  fi
fi

log_dir="${HOME:-/tmp}/.local/share/Steam/logs"
mkdir -p "${log_dir}"

{
  printf '\n[%s] launching Steam\n' "$(date -Is)"
  printf 'HOME=%s\n' "${HOME:-}"
  printf 'DISPLAY=%s\n' "${DISPLAY:-}"
  printf 'XDG_RUNTIME_DIR=%s\n' "${XDG_RUNTIME_DIR:-}"
  printf 'DBUS_SESSION_BUS_ADDRESS=%s\n' "${DBUS_SESSION_BUS_ADDRESS:-}"
  printf 'LANG=%s\n' "${LANG:-}"
  printf 'LIBGL_DRI3_ENABLE=%s\n' "${LIBGL_DRI3_ENABLE:-}"
  printf 'STEAM_RUNTIME=%s\n' "${STEAM_RUNTIME:-}"
  exec /usr/bin/steam "$@"
} >> "${log_dir}/arch-sunshine-launch.log" 2>&1
