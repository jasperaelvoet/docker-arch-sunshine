#!/usr/bin/env bash
set -euo pipefail

USER_DATA=/mnt/user_data
CONFIG_DIR="${USER_DATA}/etc/sunshine"
STATE_DIR="${USER_DATA}/var/lib/sunshine"
LOG_DIR="${USER_DATA}/var/log/arch-sunshine"
DESKTOP_USER=sunshine
DESKTOP_UID=1000
DESKTOP_GID=1000
PERSISTENT_HOME_DIR="${USER_DATA}/home/${DESKTOP_USER}"
HOME_DIR="/home/${DESKTOP_USER}"
RUNTIME_DIR="/run/user/${DESKTOP_UID}"
DISPLAY_NUM="${SUNSHINE_DISPLAY_NUM:-99}"
DISPLAY_NAME=":${DISPLAY_NUM}"
WAYLAND_SOCKET="${SUNSHINE_WAYLAND_SOCKET:-arch-sunshine-wayland}"
DISPLAY_DRIVER="${SUNSHINE_DISPLAY_DRIVER:-auto}"
ACTIVE_DISPLAY_DRIVER="${DISPLAY_DRIVER}"
CARD_NODE="${SUNSHINE_CARD_NODE:-/dev/dri/card0}"
OUTPUT_NAME="${SUNSHINE_OUTPUT_NAME:-}"
RENDER_NODE="${SUNSHINE_RENDER_NODE:-/dev/dri/renderD128}"
DEFAULT_WIDTH="${SUNSHINE_WIDTH:-1920}"
DEFAULT_HEIGHT="${SUNSHINE_HEIGHT:-1080}"
DEFAULT_REFRESH_RATE="${SUNSHINE_FPS:-60}"
DEFAULT_SCALE="${SUNSHINE_SCALE:-auto}"
WIDTH="${DEFAULT_WIDTH}"
HEIGHT="${DEFAULT_HEIGHT}"
REFRESH_RATE="${DEFAULT_REFRESH_RATE}"
SCALE=1
XORG_CONFIG="${LOG_DIR}/xorg.conf"
SESSION_RUNTIME_DIR=/run/arch-sunshine
SESSION_STATE_FILE="${SESSION_RUNTIME_DIR}/session.env"
SESSION_LOCK_DIR="${SESSION_RUNTIME_DIR}/session.lock.d"
DISCONNECT_DESKTOP_FILE="${HOME_DIR}/.local/share/applications/arch-sunshine-disconnect.desktop"
DISCONNECT_DESKTOP_ICON="${HOME_DIR}/Desktop/arch-sunshine-disconnect.desktop"
DISCONNECT_PANEL_MARKER="${HOME_DIR}/.config/arch-sunshine-disconnect-panel-added"
STEAM_SEED_DIR=/usr/share/arch-sunshine/steam/Steam
WEB_UI_USER=sunshine
WEB_UI_PASS=sunshine

log() {
  printf '%s\n' "$*"
}

run_as_desktop_user() {
  local env_args=(
    "HOME=${HOME_DIR}"
    "USER=${DESKTOP_USER}"
    "LOGNAME=${DESKTOP_USER}"
    "LANG=en_US.UTF-8"
    "LC_CTYPE=en_US.UTF-8"
    "XDG_RUNTIME_DIR=${RUNTIME_DIR}"
    "XDG_CONFIG_HOME=${HOME_DIR}/.config"
    "XDG_DATA_HOME=${HOME_DIR}/.local/share"
    "XDG_CURRENT_DESKTOP=KDE"
    "XDG_MENU_PREFIX=plasma-"
    "XDG_SESSION_DESKTOP=KDE"
    "XDG_SESSION_TYPE=x11"
    "XDG_DATA_DIRS=/usr/local/share:/usr/share"
    "XDG_CONFIG_DIRS=/etc/xdg"
    "DESKTOP_SESSION=plasma"
    "KDE_SESSION_VERSION=6"
    "KDE_FULL_SESSION=true"
    "KWIN_COMPOSE=N"
    "QT_QPA_PLATFORM=xcb"
    "LIBGL_DRI3_ENABLE=1"
    "PULSE_SERVER=unix:${RUNTIME_DIR}/pulse/native"
    "SDL_VIDEODRIVER=x11"
    "STEAM_RUNTIME=1"
    "DISPLAY=${DISPLAY_NAME}"
  )

  if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    env_args+=("DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS}")
  fi

  if [ -n "${SUNSHINE_VAAPI_DRIVER:-}" ]; then
    env_args+=("LIBVA_DRIVER_NAME=${SUNSHINE_VAAPI_DRIVER}")
  fi

  runuser -u "${DESKTOP_USER}" -- env "${env_args[@]}" "${@}"
}

run_desktop_base() {
  runuser -u "${DESKTOP_USER}" -- env \
    "HOME=${HOME_DIR}" \
    "USER=${DESKTOP_USER}" \
    "LOGNAME=${DESKTOP_USER}" \
    "LANG=en_US.UTF-8" \
    "LC_CTYPE=en_US.UTF-8" \
    "XDG_RUNTIME_DIR=${RUNTIME_DIR}" \
    "${@}"
}

set_config_value() {
  local key="$1"
  local value="$2"
  local file="${CONFIG_DIR}/sunshine.conf"

  if grep -qE "^[[:space:]]*${key}[[:space:]]*=" "${file}"; then
    sed -i -E "s|^[[:space:]]*${key}[[:space:]]*=.*|${key} = ${value}|" "${file}"
  else
    printf '%s = %s\n' "${key}" "${value}" >> "${file}"
  fi
}

sanitize_positive_int() {
  local fallback="$2"
  local max="$3"
  local value="$1"

  if [[ ! "${value}" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "${fallback}"
    return
  fi

  value=$((10#${value}))
  if [ "${value}" -lt 1 ] || [ "${value}" -gt "${max}" ]; then
    printf '%s\n' "${fallback}"
    return
  fi

  printf '%s\n' "${value}"
}

sanitize_refresh_rate() {
  local fallback="$2"
  local integer_part
  local value="$1"

  if [[ ! "${value}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    printf '%s\n' "${fallback}"
    return
  fi

  integer_part="${value%%.*}"
  integer_part=$((10#${integer_part}))
  if [ "${integer_part}" -lt 1 ] || [ "${integer_part}" -gt 240 ]; then
    printf '%s\n' "${fallback}"
    return
  fi

  printf '%s\n' "${value}"
}

sanitize_scale_request() {
  local fallback="$2"
  local value="$1"

  if [ "${value}" = "auto" ]; then
    printf '%s\n' "${value}"
    return
  fi

  if [[ ! "${value}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    printf '%s\n' "${fallback}"
    return
  fi

  awk -v value="${value}" -v fallback="${fallback}" '
    BEGIN {
      if (value < 0.5 || value > 4) {
        print fallback
      } else {
        sub(/\.?0+$/, "", value)
        print value
      }
    }
  '
}

resolve_session_scale() {
  local requested

  requested="$(sanitize_scale_request "${1:-${DEFAULT_SCALE}}" auto)"
  if [ "${requested}" != "auto" ]; then
    printf '%s\n' "${requested}"
    return
  fi

  if [ "${WIDTH}" -ge 3840 ] || [ "${HEIGHT}" -ge 2160 ]; then
    printf '2\n'
  elif [ "${WIDTH}" -ge 2880 ] || [ "${HEIGHT}" -ge 1800 ]; then
    printf '1.75\n'
  elif [ "${WIDTH}" -ge 2560 ] || [ "${HEIGHT}" -ge 1440 ]; then
    printf '1.5\n'
  elif [ "${WIDTH}" -ge 1921 ] || [ "${HEIGHT}" -ge 1200 ]; then
    printf '1.25\n'
  else
    printf '1\n'
  fi
}

scale_to_dpi() {
  awk -v scale="${1:-1}" 'BEGIN { printf "%d\n", (96 * scale) + 0.5 }'
}

set_session_geometry() {
  WIDTH="$(sanitize_positive_int "${1:-${DEFAULT_WIDTH}}" "${DEFAULT_WIDTH}" 8192)"
  HEIGHT="$(sanitize_positive_int "${2:-${DEFAULT_HEIGHT}}" "${DEFAULT_HEIGHT}" 8192)"
  REFRESH_RATE="$(sanitize_refresh_rate "${3:-${DEFAULT_REFRESH_RATE}}" "${DEFAULT_REFRESH_RATE}")"
  SCALE="$(resolve_session_scale "${4:-${DEFAULT_SCALE}}")"
}

xrandr_mode_name() {
  printf '%sx%s_%s\n' "${WIDTH}" "${HEIGHT}" "${REFRESH_RATE}"
}

xrandr_monitor_exists() {
  local name="$1"

  DISPLAY="${DISPLAY_NAME}" xrandr --listmonitors 2>/dev/null \
    | awk -v name="${name}" '
        NR > 1 {
          monitor = $2
          sub(/^[+*]+/, "", monitor)
          if (monitor == name) {
            found = 1
          }
        }
        END { exit found ? 0 : 1 }
      '
}

delete_xrandr_monitor() {
  local name="$1"

  if xrandr_monitor_exists "${name}"; then
    DISPLAY="${DISPLAY_NAME}" xrandr --delmonitor "${name}" \
      >>"${LOG_DIR}/xrandr.log" 2>&1 || true
  fi
}

reset_session_vars() {
  XORG_PID=""
  XWAYLAND_PID=""
  WESTON_PID=""
  PLASMA_PID=""
  INPUT_BRIDGE_PID=""
  WIREPLUMBER_PID=""
  PIPEWIRE_PULSE_PID=""
  PIPEWIRE_PID=""
  SESSION_DBUS_PID=""
  SYSTEM_DBUS_PID=""
  DESKTOP_ACTIVE=0
}

write_session_state() {
  install -d -m 755 "${SESSION_RUNTIME_DIR}"
  {
    printf 'ACTIVE_DISPLAY_DRIVER=%q\n' "${ACTIVE_DISPLAY_DRIVER}"
    printf 'DISPLAY_DRIVER=%q\n' "${DISPLAY_DRIVER}"
    printf 'OUTPUT_NAME=%q\n' "${OUTPUT_NAME}"
    printf 'WIDTH=%q\n' "${WIDTH}"
    printf 'HEIGHT=%q\n' "${HEIGHT}"
    printf 'REFRESH_RATE=%q\n' "${REFRESH_RATE}"
    printf 'SCALE=%q\n' "${SCALE}"
    printf 'DESKTOP_ACTIVE=%q\n' "${DESKTOP_ACTIVE:-0}"
    printf 'XORG_PID=%q\n' "${XORG_PID:-}"
    printf 'XWAYLAND_PID=%q\n' "${XWAYLAND_PID:-}"
    printf 'WESTON_PID=%q\n' "${WESTON_PID:-}"
    printf 'PLASMA_PID=%q\n' "${PLASMA_PID:-}"
    printf 'INPUT_BRIDGE_PID=%q\n' "${INPUT_BRIDGE_PID:-}"
    printf 'WIREPLUMBER_PID=%q\n' "${WIREPLUMBER_PID:-}"
    printf 'PIPEWIRE_PULSE_PID=%q\n' "${PIPEWIRE_PULSE_PID:-}"
    printf 'PIPEWIRE_PID=%q\n' "${PIPEWIRE_PID:-}"
    printf 'SESSION_DBUS_PID=%q\n' "${SESSION_DBUS_PID:-}"
    printf 'SYSTEM_DBUS_PID=%q\n' "${SYSTEM_DBUS_PID:-}"
  } > "${SESSION_STATE_FILE}"
}

load_session_state() {
  reset_session_vars

  if [ ! -f "${SESSION_STATE_FILE}" ]; then
    return 1
  fi

  # The state file is root-owned runtime data created by write_session_state.
  . "${SESSION_STATE_FILE}"
}

terminate_pid() {
  local pid="$1"

  if [ -z "${pid}" ] || ! kill -0 "${pid}" 2>/dev/null; then
    return 0
  fi

  kill "${pid}" 2>/dev/null || true
  for _ in $(seq 1 20); do
    if ! kill -0 "${pid}" 2>/dev/null; then
      return 0
    fi
    sleep 0.1
  done
  kill -KILL "${pid}" 2>/dev/null || true
}

terminate_pid_tree() {
  local child pid="$1"

  if [ -z "${pid}" ] || ! kill -0 "${pid}" 2>/dev/null; then
    return 0
  fi

  for child in $(pgrep -P "${pid}" 2>/dev/null || true); do
    terminate_pid_tree "${child}"
  done

  terminate_pid "${pid}"
}

terminate_desktop_user_processes_named() {
  local name="$1"
  local pid

  for pid in $(pgrep -u "${DESKTOP_UID}" -x "${name}" 2>/dev/null || true); do
    terminate_pid_tree "${pid}"
  done
}

acquire_session_lock() {
  local owner waited

  waited=0
  install -d -m 755 "${SESSION_RUNTIME_DIR}"

  until mkdir "${SESSION_LOCK_DIR}" 2>/dev/null; do
    owner="$(cat "${SESSION_LOCK_DIR}/pid" 2>/dev/null || true)"
    if [ -n "${owner}" ] && ! kill -0 "${owner}" 2>/dev/null; then
      rm -rf "${SESSION_LOCK_DIR}"
      continue
    fi

    if [ "${waited}" -ge 300 ]; then
      log "Timed out waiting for desktop session lock."
      return 1
    fi

    waited=$((waited + 1))
    sleep 0.1
  done

  printf '%s\n' "$$" > "${SESSION_LOCK_DIR}/pid"
}

release_session_lock() {
  rm -rf "${SESSION_LOCK_DIR}"
}

bind_home_dir() {
  mkdir -p /home "${PERSISTENT_HOME_DIR}"

  if mountpoint -q "${HOME_DIR}"; then
    return 0
  fi

  if [ -L "${HOME_DIR}" ]; then
    rm -f "${HOME_DIR}"
  elif [ -e "${HOME_DIR}" ] && [ ! -d "${HOME_DIR}" ]; then
    rm -f "${HOME_DIR}"
  fi

  mkdir -p "${HOME_DIR}"
  mount --bind "${PERSISTENT_HOME_DIR}" "${HOME_DIR}"
}

normalize_desktop_paths() {
  local places="${HOME_DIR}/.local/share/user-places.xbel"

  cat > "${HOME_DIR}/.config/user-dirs.dirs" <<EOF
XDG_DESKTOP_DIR="\$HOME/Desktop"
XDG_DOWNLOAD_DIR="\$HOME/Downloads"
XDG_TEMPLATES_DIR="\$HOME/Templates"
XDG_PUBLICSHARE_DIR="\$HOME/Public"
XDG_DOCUMENTS_DIR="\$HOME/Documents"
XDG_MUSIC_DIR="\$HOME/Music"
XDG_PICTURES_DIR="\$HOME/Pictures"
XDG_VIDEOS_DIR="\$HOME/Videos"
EOF

  if [ -f "${places}" ]; then
    sed -i \
      -e "s|file://${USER_DATA}/home/retro|file://${HOME_DIR}|g" \
      -e "s|file://${PERSISTENT_HOME_DIR}|file://${HOME_DIR}|g" \
      "${places}"
  fi
}

seed_konsole_profile() {
  mkdir -p "${HOME_DIR}/.local/share/konsole"
  cat > "${HOME_DIR}/.local/share/konsole/ArchSunshine.profile" <<EOF
[General]
Command=/bin/bash
Name=Arch Sunshine
Parent=FALLBACK/
EOF

  cat > "${HOME_DIR}/.config/konsolerc" <<EOF
[Desktop Entry]
DefaultProfile=ArchSunshine.profile
EOF
}

drm_output_name_from_status_path() {
  local drm_name

  drm_name="$(basename "$(dirname "$1")")"
  drm_name="${drm_name#card[0-9]-}"
  drm_name="${drm_name/HDMI-A-/HDMI-}"
  printf '%s\n' "${drm_name}"
}

detect_connected_output() {
  local status_path

  for status_path in /sys/class/drm/card*-*/status; do
    [ -e "${status_path}" ] || continue
    if [ "$(cat "${status_path}" 2>/dev/null || true)" = "connected" ]; then
      drm_output_name_from_status_path "${status_path}"
      return 0
    fi
  done

  return 1
}

resolve_display_driver() {
  case "${DISPLAY_DRIVER}" in
    auto)
      if [ -e "${CARD_NODE}" ] && OUTPUT_NAME="$(detect_connected_output)"; then
        ACTIVE_DISPLAY_DRIVER=modesetting
      elif [ -e "${RENDER_NODE}" ] && command -v weston >/dev/null 2>&1 && command -v Xwayland >/dev/null 2>&1; then
        ACTIVE_DISPLAY_DRIVER=xwayland
      else
        ACTIVE_DISPLAY_DRIVER=dummy
      fi
      ;;
    modesetting)
      if [ -z "${OUTPUT_NAME}" ]; then
        OUTPUT_NAME="$(detect_connected_output || true)"
      fi
      if [ -z "${OUTPUT_NAME}" ]; then
        OUTPUT_NAME=DP-1
      fi
      ACTIVE_DISPLAY_DRIVER=modesetting
      ;;
    xwayland)
      ACTIVE_DISPLAY_DRIVER=xwayland
      ;;
    *)
      ACTIVE_DISPLAY_DRIVER=dummy
      ;;
  esac
}

setup_user_data() {
  if [ -d "${USER_DATA}/home/retro" ] && [ ! -e "${PERSISTENT_HOME_DIR}" ]; then
    mv "${USER_DATA}/home/retro" "${PERSISTENT_HOME_DIR}"
  fi

  mkdir -p "${CONFIG_DIR}" "${STATE_DIR}" "${LOG_DIR}" "${PERSISTENT_HOME_DIR}" "${RUNTIME_DIR}" "${SESSION_RUNTIME_DIR}"
  mkdir -p "${PERSISTENT_HOME_DIR}/.cache" "${PERSISTENT_HOME_DIR}/.config" "${PERSISTENT_HOME_DIR}/.local/share"
  mkdir -p \
    "${PERSISTENT_HOME_DIR}/Desktop" \
    "${PERSISTENT_HOME_DIR}/Documents" \
    "${PERSISTENT_HOME_DIR}/Downloads" \
    "${PERSISTENT_HOME_DIR}/Music" \
    "${PERSISTENT_HOME_DIR}/Pictures" \
    "${PERSISTENT_HOME_DIR}/Projects" \
    "${PERSISTENT_HOME_DIR}/Public" \
    "${PERSISTENT_HOME_DIR}/Templates" \
    "${PERSISTENT_HOME_DIR}/Videos"
  chown -R "${DESKTOP_UID}:${DESKTOP_GID}" "${PERSISTENT_HOME_DIR}"
  bind_home_dir

  chown -R "${DESKTOP_UID}:${DESKTOP_GID}" "${CONFIG_DIR}" "${STATE_DIR}" "${LOG_DIR}" "${HOME_DIR}"
  chown "${DESKTOP_UID}:${DESKTOP_GID}" "${RUNTIME_DIR}"
  chmod 700 "${RUNTIME_DIR}"
  chmod 1777 /var/lib/xkb
  chmod 1777 /tmp
  rm -f "${RUNTIME_DIR}"/wayland-* "${RUNTIME_DIR}"/sway-ipc.*.sock
  rm -f /tmp/.X"${DISPLAY_NUM}"-lock
  rm -f /tmp/.X11-unix/X"${DISPLAY_NUM}"
  chmod 666 /dev/uinput /dev/uhid 2>/dev/null || true
  chmod 666 /dev/dri/card* /dev/dri/renderD* 2>/dev/null || true

  if [ ! -s /etc/machine-id ]; then
    dbus-uuidgen > /etc/machine-id
  fi
  mkdir -p /var/lib/dbus
  if [ ! -e /var/lib/dbus/machine-id ]; then
    cp /etc/machine-id /var/lib/dbus/machine-id
  fi

  if [ ! -f "${CONFIG_DIR}/sunshine.conf" ]; then
    cp /usr/share/arch-sunshine/sunshine/sunshine.conf "${CONFIG_DIR}/sunshine.conf"
  fi
  cp /usr/share/arch-sunshine/sunshine/apps.json "${CONFIG_DIR}/apps.json"

  set_config_value capture x11
  set_config_value file_apps "${CONFIG_DIR}/apps.json"
  set_config_value file_state "${STATE_DIR}/sunshine_state.json"
  set_config_value credentials_file "${STATE_DIR}/sunshine_state.json"
  set_config_value log_path "${LOG_DIR}/sunshine.log"
  set_config_value stream_audio enabled
  set_config_value audio_sink arch_sunshine_audio.monitor
  set_config_value virtual_sink arch_sunshine_audio
  set_config_value system_tray disabled
  set_config_value global_prep_cmd '[{"do":"/usr/local/bin/arch-sunshine client-start","undo":"/usr/local/bin/arch-sunshine client-stop"}]'
  rm -f "${HOME_DIR}/.cache/ksycoca6"*
  rm -rf "${HOME_DIR}/.cache/menus"
  rm -rf "${HOME_DIR}/.local/share/kscreen"
  rm -rf "${HOME_DIR}/.config/session"
  normalize_desktop_paths
  seed_konsole_profile
  seed_steam_install
  seed_disconnect_launcher
  cat > "${HOME_DIR}/.config/ksplashrc" <<EOF
[KSplash]
Engine=none
EOF
  cat > "${HOME_DIR}/.config/kded6rc" <<EOF
[Module-kscreen]
autoload=false
EOF
  cat > "${HOME_DIR}/.config/kded5rc" <<EOF
[Module-kscreen]
autoload=false
EOF
  cat > "${HOME_DIR}/.config/ksmserverrc" <<EOF
[General]
loginMode=emptySession
EOF
  chown -R "${DESKTOP_UID}:${DESKTOP_GID}" "${CONFIG_DIR}" "${STATE_DIR}" "${LOG_DIR}" "${HOME_DIR}"

  run_as_desktop_user xdg-user-dirs-update >/dev/null 2>&1 || true
  run_as_desktop_user kbuildsycoca6 --noincremental \
    >"${LOG_DIR}/kbuildsycoca.log" 2>&1 || true
}

seed_input_devices() {
  local event minor

  mkdir -p /dev/input /run/udev/data

  for event in $(seq 0 63); do
    minor=$((64 + event))
    mknod -m 666 "/dev/input/event${event}" c 13 "${minor}" 2>/dev/null || true
    chmod 666 "/dev/input/event${event}" 2>/dev/null || true
    cat > "/run/udev/data/c13:${minor}" <<EOF
I:0
E:ID_INPUT=1
E:ID_INPUT_KEYBOARD=1
E:ID_INPUT_MOUSE=1
E:ID_SEAT=seat0
E:ID_FOR_SEAT=input-event${event}
G:seat
Q:seat
V:1
EOF
  done
}

seed_web_credentials() {
  run_as_desktop_user sunshine "${CONFIG_DIR}/sunshine.conf" --creds "${WEB_UI_USER}" "${WEB_UI_PASS}" \
    >"${LOG_DIR}/credentials.log" 2>&1
}

seed_disconnect_launcher() {
  mkdir -p "$(dirname "${DISCONNECT_DESKTOP_FILE}")" "$(dirname "${DISCONNECT_DESKTOP_ICON}")"

  cat > "${DISCONNECT_DESKTOP_FILE}" <<'EOF'
[Desktop Entry]
Type=Application
Name=Disconnect
Comment=Close the Moonlight stream and stop the desktop session
Exec=/usr/local/bin/arch-sunshine disconnect
Icon=system-log-out
Terminal=false
Categories=System;
StartupNotify=false
NoDisplay=false
EOF

  cp "${DISCONNECT_DESKTOP_FILE}" "${DISCONNECT_DESKTOP_ICON}"
  chmod 644 "${DISCONNECT_DESKTOP_FILE}"
  chmod 755 "${DISCONNECT_DESKTOP_ICON}"
  chown "${DESKTOP_UID}:${DESKTOP_GID}" "${DISCONNECT_DESKTOP_FILE}" "${DISCONNECT_DESKTOP_ICON}"
}

rewrite_steam_seed_links() {
  local link suffix target

  while IFS= read -r -d '' link; do
    target="$(readlink "${link}" 2>/dev/null || true)"
    case "${target}" in
      */.local/share/Steam/*)
        suffix="${target#*/.local/share/Steam/}"
        ln -sfn "${HOME_DIR}/.local/share/Steam/${suffix}" "${link}"
        ;;
    esac
  done < <(find "${PERSISTENT_HOME_DIR}/.local/share/Steam" -type l -print0 2>/dev/null)
}

ensure_steam_links() {
  local steam_config="${PERSISTENT_HOME_DIR}/.steam"

  mkdir -p "${steam_config}"
  ln -sfn "${HOME_DIR}/.local/share/Steam" "${steam_config}/steam"
  ln -sfn "${HOME_DIR}/.local/share/Steam" "${steam_config}/root"
  ln -sfn "${HOME_DIR}/.local/share/Steam/ubuntu12_32" "${steam_config}/bin32"
  ln -sfn "${HOME_DIR}/.local/share/Steam/ubuntu12_64" "${steam_config}/bin64"
  ln -sfn "${HOME_DIR}/.local/share/Steam/linux32" "${steam_config}/sdk32"
  ln -sfn "${HOME_DIR}/.local/share/Steam/linux64" "${steam_config}/sdk64"
  ln -sfn "${HOME_DIR}/.steam/bin32" "${steam_config}/bin"
  rm -f "${steam_config}/steam.pid" "${steam_config}/steam.pipe" "${steam_config}/steam.token"
}

seed_steam_install() {
  local steam_dir="${PERSISTENT_HOME_DIR}/.local/share/Steam"

  if [ ! -x "${steam_dir}/steam.sh" ] && [ -x "${STEAM_SEED_DIR}/steam.sh" ]; then
    log "Seeding Steam client into ${steam_dir}."
    rm -rf "${steam_dir}"
    mkdir -p "$(dirname "${steam_dir}")"
    cp -a "${STEAM_SEED_DIR}" "${steam_dir}"
    rewrite_steam_seed_links
  fi

  if [ -d "${steam_dir}" ]; then
    ensure_steam_links
    chown -R "${DESKTOP_UID}:${DESKTOP_GID}" "${steam_dir}" "${PERSISTENT_HOME_DIR}/.steam"
  fi
}

write_desktop_env() {
  mkdir -p "${HOME_DIR}/.config/plasma-workspace/env"
  cat > "${HOME_DIR}/.config/plasma-workspace/env/arch-sunshine.sh" <<EOF
export XDG_CURRENT_DESKTOP=KDE
export XDG_MENU_PREFIX=plasma-
export XDG_SESSION_DESKTOP=KDE
export XDG_SESSION_TYPE=x11
export DESKTOP_SESSION=plasma
export KDE_SESSION_VERSION=6
export KDE_FULL_SESSION=true
export KWIN_COMPOSE=N
export QT_QPA_PLATFORM=xcb
export MOZ_ENABLE_WAYLAND=0
export SDL_VIDEODRIVER=x11
export LIBGL_DRI3_ENABLE=1
export PULSE_SERVER=unix:${RUNTIME_DIR}/pulse/native
EOF
  chown -R "${DESKTOP_UID}:${DESKTOP_GID}" "${HOME_DIR}/.config"
}

active_xrandr_output() {
  DISPLAY="${DISPLAY_NAME}" xrandr --query 2>/dev/null \
    | awk '/ connected/ { print $1; exit }'
}

write_kde_config_value() {
  local file="$1"
  local group="$2"
  local key="$3"
  local value="$4"

  command -v kwriteconfig6 >/dev/null 2>&1 || return 1
  run_desktop_base \
    "XDG_CONFIG_HOME=${HOME_DIR}/.config" \
    kwriteconfig6 \
      --file "${file}" \
      --group "${group}" \
      --key "${key}" \
      "${value}" >/dev/null 2>&1
}

write_kde_action_restrictions() {
  local file="${HOME_DIR}/.config/kdeglobals"

  write_kde_config_value kdeglobals "KDE Action Restrictions" "action/lock_screen" false || true
  write_kde_config_value kdeglobals "KDE Action Restrictions" lock_screen false || true
  write_kde_config_value kdeglobals "KDE Action Restrictions" logout false || true
  write_kde_config_value kdeglobals "KDE Action Restrictions" "action/logout" false || true

  if [ -f "${file}" ]; then
    sed -i -E 's/^\[KDE Action Restrictions\]$/[KDE Action Restrictions][$i]/' "${file}"
  fi
}

write_kde_session_config() {
  local dpi output scale_factors

  dpi="$(scale_to_dpi "${SCALE}")"
  output="$(active_xrandr_output || true)"
  if [ -z "${output}" ] || [ "${output}" = "none" ]; then
    if [ "${ACTIVE_DISPLAY_DRIVER}" = "xwayland" ]; then
      output=XWAYLAND0
    else
      output="${OUTPUT_NAME:-ArchSunshine}"
    fi
  fi
  scale_factors="${output}=${SCALE};"

  mkdir -p "${HOME_DIR}/.config"
  write_kde_config_value kwinrc Compositing Enabled false || true
  write_kde_config_value kdeglobals KScreen ScaleFactor "${SCALE}" || true
  write_kde_config_value kdeglobals KScreen ScreenScaleFactors "${scale_factors}" || true
  write_kde_config_value kdeglobals General Xft.dpi "${dpi}" || true
  write_kde_config_value kcmfonts General forceFontDPI "${dpi}" || true
  write_kde_action_restrictions
  chown -R "${DESKTOP_UID}:${DESKTOP_GID}" "${HOME_DIR}/.config"
}

apply_xrandr_dpi() {
  local dpi

  dpi="$(scale_to_dpi "${SCALE}")"
  DISPLAY="${DISPLAY_NAME}" xrandr --dpi "${dpi}" \
    >>"${LOG_DIR}/xrandr.log" 2>&1 || true
}

apply_desktop_scale_runtime() {
  local output

  write_kde_session_config
  apply_xrandr_dpi

  output="$(active_xrandr_output || true)"
  if [ -n "${output}" ] && [ "${output}" != "none" ]; then
    run_as_desktop_user kscreen-doctor "output.${output}.scale.${SCALE}" \
      >"${LOG_DIR}/scale.log" 2>&1 || true
  fi

  run_as_desktop_user qdbus6 org.kde.KWin /KWin reconfigure \
    >>"${LOG_DIR}/scale.log" 2>&1 || true
  run_as_desktop_user qdbus6 org.kde.KWin /Compositor suspend \
    >>"${LOG_DIR}/scale.log" 2>&1 || true
}

ensure_disconnect_panel_button() {
  local launcher_url output script

  if [ -f "${DISCONNECT_PANEL_MARKER}" ] || [ ! -f "${DISCONNECT_DESKTOP_FILE}" ]; then
    return 0
  fi

  command -v qdbus6 >/dev/null 2>&1 || return 0
  launcher_url="file://${DISCONNECT_DESKTOP_FILE}"
  script="$(cat <<EOF
var result = "arch-sunshine-disconnect-no-panel";
var panelList = panels();
if (panelList.length > 0) {
    var widget = panelList[0].addWidget("org.kde.plasma.icon");
    widget.currentConfigGroup = ["General"];
    widget.writeConfig("url", "${launcher_url}");
    result = "arch-sunshine-disconnect-added";
}
print(result);
result;
EOF
)"

  if output="$(
    run_as_desktop_user qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "${script}" 2>&1
  )"; then
    printf '%s\n' "${output}" >"${LOG_DIR}/disconnect-panel.log"
  else
    printf '%s\n' "${output}" >"${LOG_DIR}/disconnect-panel.log"
    return 0
  fi

  sleep 0.2
  if printf '%s\n' "${output}" | grep -q 'arch-sunshine-disconnect-added' \
    || grep -Fqx "url=${launcher_url}" "${HOME_DIR}/.config/plasma-org.kde.plasma.desktop-appletsrc" 2>/dev/null; then
    touch "${DISCONNECT_PANEL_MARKER}"
    chown "${DESKTOP_UID}:${DESKTOP_GID}" "${DISCONNECT_PANEL_MARKER}"
  fi
}

ensure_panel_task_launchers() {
  local applet_group group_args group_part launchers output script

  launchers="applications:org.kde.dolphin.desktop,applications:firefox.desktop,applications:steam.desktop"

  if command -v kwriteconfig6 >/dev/null 2>&1 && [ -f "${HOME_DIR}/.config/plasma-org.kde.plasma.desktop-appletsrc" ]; then
    while IFS= read -r applet_group; do
      applet_group="${applet_group#[}"
      applet_group="${applet_group%]}"
      group_args=()
      while IFS= read -r group_part; do
        group_args+=(--group "${group_part}")
      done < <(printf '%s\n' "${applet_group}" | sed 's/]\[/\n/g')

      run_as_desktop_user kwriteconfig6 \
        --file "${HOME_DIR}/.config/plasma-org.kde.plasma.desktop-appletsrc" \
        "${group_args[@]}" \
        --group Configuration \
        --group General \
        --key launchers \
        "${launchers}" >/dev/null 2>&1 || true
    done < <(
      awk '
        /^\[Containments\]\[[^]]+\]\[Applets\]\[[^]]+\]$/ {
          group = $0
          in_group = 1
          next
        }
        /^\[/ {
          in_group = 0
        }
        in_group && $0 == "plugin=org.kde.plasma.icontasks" {
          print group
        }
      ' "${HOME_DIR}/.config/plasma-org.kde.plasma.desktop-appletsrc"
    )
  fi

  command -v qdbus6 >/dev/null 2>&1 || return 0
  script="$(cat <<EOF
var launchers = "${launchers}";
var changed = 0;
panels().forEach(function(panel) {
    panel.widgets().forEach(function(widget) {
        var plugin = widget.type || widget.pluginName || "";
        if (plugin == "org.kde.plasma.icontasks") {
            widget.currentConfigGroup = ["General"];
            widget.writeConfig("launchers", launchers);
            changed++;
        }
    });
});
print("arch-sunshine-panel-launchers-set=" + changed);
"arch-sunshine-panel-launchers-set=" + changed;
EOF
)"

  for _ in $(seq 1 50); do
    if output="$(
      run_as_desktop_user qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "${script}" 2>&1
    )"; then
      printf '%s\n' "${output}" >"${LOG_DIR}/panel-launchers.log"
      if printf '%s\n' "${output}" | grep -q 'arch-sunshine-panel-launchers-set=[1-9]'; then
        return 0
      fi
    else
      printf '%s\n' "${output}" >"${LOG_DIR}/panel-launchers.log"
    fi
    sleep 0.2
  done
}

write_xorg_config() {
  local driver="${1:-${DISPLAY_DRIVER}}"
  local mode_line
  local mode_name

  ACTIVE_DISPLAY_DRIVER="${driver}"
  write_desktop_env
  mode_name="$(xrandr_mode_name)"
  mode_line="$(cvt "${WIDTH}" "${HEIGHT}" "${REFRESH_RATE}" | awk '/Modeline/ {sub(/^Modeline /, ""); print}')"
  if [ -z "${mode_line}" ]; then
    mode_line="\"${mode_name}\" 173.00 ${WIDTH} $((WIDTH + 2048)) $((WIDTH + 2248)) $((WIDTH + 2576)) ${HEIGHT} $((HEIGHT + 3)) $((HEIGHT + 8)) $((HEIGHT + 38)) -hsync +vsync"
  fi

  if [ "${driver}" = "modesetting" ]; then
    cat > "${XORG_CONFIG}" <<EOF
Section "ServerFlags"
    Option "AutoAddDevices" "true"
    Option "DontVTSwitch" "true"
    Option "AllowMouseOpenFail" "true"
    Option "BlankTime" "0"
    Option "StandbyTime" "0"
    Option "SuspendTime" "0"
    Option "OffTime" "0"
EndSection

Section "InputClass"
    Identifier "Arch Sunshine Input Bridge"
    MatchProduct "Arch Sunshine Input Bridge"
    Driver "libinput"
EndSection

Section "Device"
    Identifier "ArchSunshineGPU"
    Driver "modesetting"
    Option "kmsdev" "${CARD_NODE}"
    Option "AccelMethod" "glamor"
    Option "PageFlip" "true"
    Option "PrimaryGPU" "true"
EndSection

Section "Monitor"
    Identifier "ArchSunshineMonitor"
    HorizSync 5.0 - 1000.0
    VertRefresh 5.0 - 200.0
EndSection

Section "Screen"
    Identifier "ArchSunshineScreen"
    Device "ArchSunshineGPU"
    Monitor "ArchSunshineMonitor"
    DefaultDepth 24
    SubSection "Display"
        Depth 24
        Virtual ${WIDTH} ${HEIGHT}
    EndSubSection
EndSection
EOF
  else
    cat > "${XORG_CONFIG}" <<EOF
Section "ServerFlags"
    Option "AutoAddDevices" "true"
    Option "DontVTSwitch" "true"
    Option "AllowMouseOpenFail" "true"
EndSection

Section "InputClass"
    Identifier "Arch Sunshine Input Bridge"
    MatchProduct "Arch Sunshine Input Bridge"
    Driver "libinput"
EndSection

Section "Device"
    Identifier "DummyDevice"
    Driver "dummy"
    VideoRam 512000
EndSection

Section "Monitor"
    Identifier "DummyMonitor"
    HorizSync 5.0 - 1000.0
    VertRefresh 5.0 - 200.0
    Modeline ${mode_line}
EndSection

Section "Screen"
    Identifier "DummyScreen"
    Device "DummyDevice"
    Monitor "DummyMonitor"
    DefaultDepth 24
    SubSection "Display"
        Depth 24
        Modes "${mode_name}"
        Virtual ${WIDTH} ${HEIGHT}
    EndSubSection
EndSection
EOF
  fi
}

configure_xrandr_monitor() {
  local height_mm mode_args mode_line mode_name monitor_name output width_mm

  mode_name="$(xrandr_mode_name)"
  mode_line="$(cvt "${WIDTH}" "${HEIGHT}" "${REFRESH_RATE}" | awk '/Modeline/ {sub(/^Modeline /, ""); print}')"
  if [ -z "${mode_line}" ]; then
    mode_line="\"${mode_name}\" 173.00 ${WIDTH} $((WIDTH + 2048)) $((WIDTH + 2248)) $((WIDTH + 2576)) ${HEIGHT} $((HEIGHT + 3)) $((HEIGHT + 8)) $((HEIGHT + 38)) -hsync +vsync"
  fi
  mode_args="${mode_line#\"${mode_name}\" }"
  width_mm=$((WIDTH * 254 / 960))
  height_mm=$((HEIGHT * 254 / 960))
  output=none

  DISPLAY="${DISPLAY_NAME}" xrandr --fb "${WIDTH}x${HEIGHT}" \
    >"${LOG_DIR}/xrandr.log" 2>&1 || true

  if [ "${ACTIVE_DISPLAY_DRIVER}" = "modesetting" ]; then
    DISPLAY="${DISPLAY_NAME}" xrandr --newmode "${mode_name}" ${mode_args} \
      >>"${LOG_DIR}/xrandr.log" 2>&1 || true
    DISPLAY="${DISPLAY_NAME}" xrandr --addmode "${OUTPUT_NAME}" "${mode_name}" \
      >>"${LOG_DIR}/xrandr.log" 2>&1 || true
    DISPLAY="${DISPLAY_NAME}" xrandr --output "${OUTPUT_NAME}" --mode "${mode_name}" --rate "${REFRESH_RATE}" --primary \
      >>"${LOG_DIR}/xrandr.log" 2>&1 || true
    output="${OUTPUT_NAME}"
  elif [ "${ACTIVE_DISPLAY_DRIVER}" = "xwayland" ]; then
    output="$(
      DISPLAY="${DISPLAY_NAME}" xrandr --query 2>/dev/null \
        | awk '/ connected/ { print $1; exit }'
    )"
    if [ -n "${output}" ]; then
      DISPLAY="${DISPLAY_NAME}" xrandr --output "${output}" --mode "${WIDTH}x${HEIGHT}" --rate "${REFRESH_RATE}" --primary \
        >>"${LOG_DIR}/xrandr.log" 2>&1 || true
    else
      output=none
    fi
  fi

  monitor_name=ArchSunshine
  if [ "${output}" != "none" ]; then
    monitor_name="${output}"
  fi

  delete_xrandr_monitor ArchSunshine
  if [ "${monitor_name}" != "ArchSunshine" ]; then
    delete_xrandr_monitor "${monitor_name}"
  fi
  DISPLAY="${DISPLAY_NAME}" xrandr --setmonitor "${monitor_name}" "${WIDTH}/${width_mm}x${HEIGHT}/${height_mm}+0+0" "${output}" \
    >>"${LOG_DIR}/xrandr.log" 2>&1 || true
  apply_xrandr_dpi
}

launch_xorg_process() {
  rm -f /tmp/.X"${DISPLAY_NUM}"-lock
  rm -f /tmp/.X11-unix/X"${DISPLAY_NUM}"

  Xorg "${DISPLAY_NAME}" \
    -config "${XORG_CONFIG}" \
    -noreset \
    -ac \
    -nolisten tcp \
    -logfile "${LOG_DIR}/xorg.log" \
    >"${LOG_DIR}/xorg.stdout.log" 2>&1 &
  XORG_PID=$!

  for _ in $(seq 1 100); do
    if ! kill -0 "${XORG_PID}" 2>/dev/null; then
      return 1
    fi
    if DISPLAY="${DISPLAY_NAME}" xdpyinfo >/dev/null 2>&1; then
      configure_xrandr_monitor
      return 0
    fi
    sleep 0.1
  done

  return 1
}

launch_weston_process() {
  rm -f "${RUNTIME_DIR}/${WAYLAND_SOCKET}" "${RUNTIME_DIR}/${WAYLAND_SOCKET}.lock"

  run_desktop_base \
    WLR_RENDER_DRM_DEVICE="${RENDER_NODE}" \
    weston \
      --backend=headless-backend.so \
      --renderer=gl \
      --width="${WIDTH}" \
      --height="${HEIGHT}" \
      --socket="${WAYLAND_SOCKET}" \
      --idle-time=0 \
    >"${LOG_DIR}/weston.log" 2>&1 &
  WESTON_PID=$!

  for _ in $(seq 1 100); do
    if [ -S "${RUNTIME_DIR}/${WAYLAND_SOCKET}" ]; then
      return 0
    fi
    if ! kill -0 "${WESTON_PID}" 2>/dev/null; then
      return 1
    fi
    sleep 0.1
  done

  return 1
}

launch_xwayland_process() {
  rm -f /tmp/.X"${DISPLAY_NUM}"-lock
  rm -f /tmp/.X11-unix/X"${DISPLAY_NUM}"

  run_desktop_base \
    WAYLAND_DISPLAY="${WAYLAND_SOCKET}" \
    Xwayland "${DISPLAY_NAME}" \
      -geometry "${WIDTH}x${HEIGHT}" \
      -fullscreen \
      -ac \
      -noreset \
      -glamor es \
      -verbose 2 \
    >"${LOG_DIR}/xwayland.log" 2>&1 &
  XWAYLAND_PID=$!

  for _ in $(seq 1 100); do
    if ! kill -0 "${XWAYLAND_PID}" 2>/dev/null; then
      return 1
    fi
    if DISPLAY="${DISPLAY_NAME}" xdpyinfo >/dev/null 2>&1; then
      configure_xrandr_monitor
      DISPLAY="${DISPLAY_NAME}" xset s off -dpms >/dev/null 2>&1 || true
      return 0
    fi
    sleep 0.1
  done

  return 1
}

stop_xorg_process() {
  if [ -n "${XORG_PID:-}" ]; then
    terminate_pid_tree "${XORG_PID}"
  fi
  XORG_PID=""

  rm -f /tmp/.X"${DISPLAY_NUM}"-lock
  rm -f /tmp/.X11-unix/X"${DISPLAY_NUM}"
}

stop_xwayland_process() {
  if [ -n "${XWAYLAND_PID:-}" ]; then
    terminate_pid_tree "${XWAYLAND_PID}"
  fi
  XWAYLAND_PID=""
  terminate_desktop_user_processes_named Xwayland

  if [ -n "${WESTON_PID:-}" ]; then
    terminate_pid_tree "${WESTON_PID}"
  fi
  WESTON_PID=""
  terminate_desktop_user_processes_named weston
  terminate_desktop_user_processes_named weston-keyboard
  terminate_desktop_user_processes_named weston-desktop-

  rm -f /tmp/.X"${DISPLAY_NUM}"-lock
  rm -f /tmp/.X11-unix/X"${DISPLAY_NUM}"
  rm -f "${RUNTIME_DIR}/${WAYLAND_SOCKET}" "${RUNTIME_DIR}/${WAYLAND_SOCKET}.lock"
}

launch_plasma_process() {
  run_as_desktop_user startplasma-x11 \
    >"${LOG_DIR}/plasma.log" 2>&1 &
  PLASMA_PID=$!

  for _ in $(seq 1 160); do
    if DISPLAY="${DISPLAY_NAME}" pgrep -u "${DESKTOP_UID}" -x plasmashell >/dev/null 2>&1; then
      return 0
    fi
    if ! kill -0 "${PLASMA_PID}" 2>/dev/null; then
      return 1
    fi
    sleep 0.1
  done

  return 1
}

stop_display_processes() {
  [ -n "${PLASMA_PID:-}" ] && terminate_pid "${PLASMA_PID}"
  pkill -TERM -u "${DESKTOP_UID}" -x plasmashell 2>/dev/null || true
  pkill -TERM -u "${DESKTOP_UID}" -x kwin_x11 2>/dev/null || true
  pkill -TERM -u "${DESKTOP_UID}" -x kded6 2>/dev/null || true
  PLASMA_PID=""

  stop_xorg_process
  stop_xwayland_process
  sleep 0.3
  pkill -KILL -u "${DESKTOP_UID}" -x plasmashell 2>/dev/null || true
  pkill -KILL -u "${DESKTOP_UID}" -x kwin_x11 2>/dev/null || true

  rm -f /tmp/.X"${DISPLAY_NUM}"-lock
  rm -f /tmp/.X11-unix/X"${DISPLAY_NUM}"
}

start_system_bus() {
  mkdir -p /run/dbus
  rm -f /run/dbus/system_bus_socket /run/dbus/pid

  dbus-daemon --system --nofork --nopidfile \
    >"${LOG_DIR}/dbus-system.log" 2>&1 &
  SYSTEM_DBUS_PID=$!

  for _ in $(seq 1 50); do
    if [ -S /run/dbus/system_bus_socket ]; then
      return 0
    fi
    if ! kill -0 "${SYSTEM_DBUS_PID}" 2>/dev/null; then
      return 1
    fi
    sleep 0.1
  done

  return 1
}

start_session_bus() {
  local output

  rm -f "${RUNTIME_DIR}/bus"
  output="$(
    run_desktop_base dbus-daemon \
      --session \
      --fork \
      --address="unix:path=${RUNTIME_DIR}/bus" \
      --print-address \
      --print-pid
  )"
  DBUS_SESSION_BUS_ADDRESS="$(printf '%s\n' "${output}" | sed -n '1p')"
  SESSION_DBUS_PID="$(printf '%s\n' "${output}" | sed -n '2p')"
  export DBUS_SESSION_BUS_ADDRESS

  for _ in $(seq 1 50); do
    if [ -S "${RUNTIME_DIR}/bus" ]; then
      return 0
    fi
    if [ -n "${SESSION_DBUS_PID:-}" ] && ! kill -0 "${SESSION_DBUS_PID}" 2>/dev/null; then
      return 1
    fi
    sleep 0.1
  done

  return 1
}

start_pipewire() {
  run_as_desktop_user pipewire >"${LOG_DIR}/pipewire.log" 2>&1 &
  PIPEWIRE_PID=$!

  for _ in $(seq 1 50); do
    if [ -S "${RUNTIME_DIR}/pipewire-0" ]; then
      break
    fi
    if ! kill -0 "${PIPEWIRE_PID}" 2>/dev/null; then
      return 1
    fi
    sleep 0.1
  done

  if [ ! -S "${RUNTIME_DIR}/pipewire-0" ]; then
    return 1
  fi

  run_as_desktop_user wireplumber >"${LOG_DIR}/wireplumber.log" 2>&1 &
  WIREPLUMBER_PID=$!

  run_as_desktop_user pipewire-pulse >"${LOG_DIR}/pipewire-pulse.log" 2>&1 &
  PIPEWIRE_PULSE_PID=$!

  for _ in $(seq 1 50); do
    if [ -S "${RUNTIME_DIR}/pulse/native" ]; then
      break
    fi
    if ! kill -0 "${PIPEWIRE_PID}" 2>/dev/null || ! kill -0 "${PIPEWIRE_PULSE_PID}" 2>/dev/null; then
      return 1
    fi
    sleep 0.1
  done

  if [ ! -S "${RUNTIME_DIR}/pulse/native" ]; then
    return 1
  fi

  ensure_audio_sink
}

ensure_audio_sink() {
  local pactl_env=(
    "XDG_RUNTIME_DIR=${RUNTIME_DIR}"
    "PULSE_SERVER=unix:${RUNTIME_DIR}/pulse/native"
  )

  if ! runuser -u "${DESKTOP_USER}" -- env "${pactl_env[@]}" pactl list short sinks \
    | awk '{print $2}' | grep -qx arch_sunshine_audio; then
    runuser -u "${DESKTOP_USER}" -- env "${pactl_env[@]}" pactl load-module module-null-sink \
      sink_name=arch_sunshine_audio \
      sink_properties=device.description=Arch_Sunshine_Audio \
      >"${LOG_DIR}/audio-sink.log" 2>&1 || return 1
  fi

  runuser -u "${DESKTOP_USER}" -- env "${pactl_env[@]}" pactl list short sinks \
    >"${LOG_DIR}/audio-sinks.log" 2>&1 || true
  runuser -u "${DESKTOP_USER}" -- env "${pactl_env[@]}" pactl list short sources \
    >"${LOG_DIR}/audio-sources.log" 2>&1 || true

  return 0
}

start_input_bridge() {
  local mode=evdev

  if [ -n "${INPUT_BRIDGE_PID:-}" ] && kill -0 "${INPUT_BRIDGE_PID}" 2>/dev/null; then
    return 0
  fi

  if [ "${ACTIVE_DISPLAY_DRIVER}" = "xwayland" ]; then
    mode=xtest
    DISPLAY="${DISPLAY_NAME}" \
      XDG_RUNTIME_DIR="${RUNTIME_DIR}" \
      ARCH_SUNSHINE_INPUT_MODE=xtest \
      arch-sunshine-input-bridge >"${LOG_DIR}/input-bridge.log" 2>&1 &
  else
    arch-sunshine-input-bridge >"${LOG_DIR}/input-bridge.log" 2>&1 &
  fi
  INPUT_BRIDGE_PID=$!

  for _ in $(seq 1 50); do
    seed_input_devices
    if [ "${mode}" = "xtest" ] && kill -0 "${INPUT_BRIDGE_PID}" 2>/dev/null; then
      return 0
    fi
    if grep -q 'Arch Sunshine Input Bridge' /proc/bus/input/devices 2>/dev/null; then
      return 0
    fi
    if ! kill -0 "${INPUT_BRIDGE_PID}" 2>/dev/null; then
      return 1
    fi
    sleep 0.1
  done

  return 1
}

start_capture_display() {
  seed_input_devices
  resolve_display_driver

  if [ "${ACTIVE_DISPLAY_DRIVER}" = "xwayland" ]; then
    write_desktop_env
    if ! launch_weston_process || ! launch_xwayland_process; then
      stop_xwayland_process
      log "GPU Xwayland display failed; falling back to dummy Xorg."
      write_xorg_config dummy
      launch_xorg_process || return 1
    fi
  elif [ "${ACTIVE_DISPLAY_DRIVER}" = "modesetting" ] && [ -e "${CARD_NODE}" ]; then
    write_xorg_config "${ACTIVE_DISPLAY_DRIVER}"
    if ! launch_xorg_process; then
      stop_xorg_process
      log "GPU modesetting display failed; falling back to dummy Xorg."
      write_xorg_config dummy
      launch_xorg_process || return 1
    fi
  else
    if [ "${DISPLAY_DRIVER}" != "dummy" ]; then
      log "No connected DRM output found; using dummy Xorg for Plasma."
    fi
    write_xorg_config dummy
    launch_xorg_process || return 1
  fi
}

start_desktop_services() {
  if [ "${ACTIVE_DISPLAY_DRIVER}" != "xwayland" ]; then
    start_input_bridge || return 1
  fi
  start_system_bus || return 1
  start_session_bus || return 1
  start_pipewire || return 1

  if [ "${ACTIVE_DISPLAY_DRIVER}" = "xwayland" ]; then
    start_input_bridge || return 1
  fi

  write_kde_session_config
  launch_plasma_process || return 1
  apply_desktop_scale_runtime
  ensure_panel_task_launchers
  ensure_disconnect_panel_button
}

start_display() {
  start_capture_display || return 1
  start_desktop_services
}

start_sunshine() {
  if [ -n "${SUNSHINE_VAAPI_DRIVER:-}" ]; then
    export LIBVA_DRIVER_NAME="${SUNSHINE_VAAPI_DRIVER}"
  fi

  run_as_desktop_user sunshine "${CONFIG_DIR}/sunshine.conf" >"${LOG_DIR}/sunshine.stdout.log" 2>&1 &
  SUNSHINE_PID=$!
}

prepare_session_runtime() {
  mkdir -p "${CONFIG_DIR}" "${STATE_DIR}" "${LOG_DIR}" "${PERSISTENT_HOME_DIR}" "${RUNTIME_DIR}" "${SESSION_RUNTIME_DIR}"
  bind_home_dir
  chown -R "${DESKTOP_UID}:${DESKTOP_GID}" "${CONFIG_DIR}" "${STATE_DIR}" "${LOG_DIR}"
  chown "${DESKTOP_UID}:${DESKTOP_GID}" "${HOME_DIR}" 2>/dev/null || true
  chown "${DESKTOP_UID}:${DESKTOP_GID}" "${RUNTIME_DIR}"
  chmod 700 "${RUNTIME_DIR}"
  chmod 1777 /var/lib/xkb /tmp
  chmod 666 /dev/uinput /dev/uhid 2>/dev/null || true
  chmod 666 /dev/dri/card* /dev/dri/renderD* 2>/dev/null || true
}

session_has_live_process() {
  local pid

  for pid in \
    "${XORG_PID:-}" \
    "${XWAYLAND_PID:-}" \
    "${WESTON_PID:-}" \
    "${PLASMA_PID:-}" \
    "${INPUT_BRIDGE_PID:-}" \
    "${PIPEWIRE_PID:-}" \
    "${PIPEWIRE_PULSE_PID:-}" \
    "${WIREPLUMBER_PID:-}" \
    "${SESSION_DBUS_PID:-}" \
    "${SYSTEM_DBUS_PID:-}"; do
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
      return 0
    fi
  done

  return 1
}

capture_display_live() {
  local pid

  for pid in "${XORG_PID:-}" "${XWAYLAND_PID:-}" "${WESTON_PID:-}"; do
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
      DISPLAY="${DISPLAY_NAME}" xdpyinfo >/dev/null 2>&1 && return 0
    fi
  done

  return 1
}

desktop_session_live() {
  local pid

  for pid in \
    "${PLASMA_PID:-}" \
    "${INPUT_BRIDGE_PID:-}" \
    "${PIPEWIRE_PID:-}" \
    "${PIPEWIRE_PULSE_PID:-}" \
    "${WIREPLUMBER_PID:-}" \
    "${SESSION_DBUS_PID:-}" \
    "${SYSTEM_DBUS_PID:-}"; do
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
      return 0
    fi
  done

  return 1
}

x_display_size_matches() {
  local actual

  actual="$(current_x_display_size)"
  [ "${actual}" = "${WIDTH}x${HEIGHT}" ]
}

current_x_display_size() {
  DISPLAY="${DISPLAY_NAME}" xdpyinfo 2>/dev/null \
    | awk '/dimensions:/ { print $2; exit }'
}

stop_desktop_user_processes() {
  local comm pid

  for pid in $(pgrep -u "${DESKTOP_UID}" 2>/dev/null || true); do
    case "${pid}" in
      "${XWAYLAND_PID:-}"|"${WESTON_PID:-}"|"${XORG_PID:-}") continue ;;
    esac
    comm="$(cat "/proc/${pid}/comm" 2>/dev/null || true)"
    case "${comm}" in
      sunshine|Xwayland|weston|Xorg) continue ;;
    esac
    kill -TERM "${pid}" 2>/dev/null || true
  done

  sleep 0.5

  for pid in $(pgrep -u "${DESKTOP_UID}" 2>/dev/null || true); do
    case "${pid}" in
      "${XWAYLAND_PID:-}"|"${WESTON_PID:-}"|"${XORG_PID:-}") continue ;;
    esac
    comm="$(cat "/proc/${pid}/comm" 2>/dev/null || true)"
    case "${comm}" in
      sunshine|Xwayland|weston|Xorg) continue ;;
    esac
    kill -KILL "${pid}" 2>/dev/null || true
  done
}

stop_desktop_services() {
  [ -n "${PLASMA_PID:-}" ] && terminate_pid "${PLASMA_PID}"
  pkill -TERM -u "${DESKTOP_UID}" -x plasmashell 2>/dev/null || true
  pkill -TERM -u "${DESKTOP_UID}" -x kwin_x11 2>/dev/null || true
  pkill -TERM -u "${DESKTOP_UID}" -x kded6 2>/dev/null || true
  PLASMA_PID=""

  [ -n "${INPUT_BRIDGE_PID:-}" ] && terminate_pid "${INPUT_BRIDGE_PID}"
  INPUT_BRIDGE_PID=""

  stop_desktop_user_processes

  [ -n "${WIREPLUMBER_PID:-}" ] && terminate_pid "${WIREPLUMBER_PID}"
  [ -n "${PIPEWIRE_PULSE_PID:-}" ] && terminate_pid "${PIPEWIRE_PULSE_PID}"
  [ -n "${PIPEWIRE_PID:-}" ] && terminate_pid "${PIPEWIRE_PID}"
  [ -n "${SESSION_DBUS_PID:-}" ] && terminate_pid "${SESSION_DBUS_PID}"
  [ -n "${SYSTEM_DBUS_PID:-}" ] && terminate_pid "${SYSTEM_DBUS_PID}"

  WIREPLUMBER_PID=""
  PIPEWIRE_PULSE_PID=""
  PIPEWIRE_PID=""
  SESSION_DBUS_PID=""
  SYSTEM_DBUS_PID=""
  DESKTOP_ACTIVE=0

  rm -f "${RUNTIME_DIR}/pipewire-0" "${RUNTIME_DIR}/pulse/native" "${RUNTIME_DIR}/bus"
}

stop_desktop_runtime() {
  stop_desktop_services
  stop_display_processes
  rm -f "${RUNTIME_DIR}/${WAYLAND_SOCKET}" "${RUNTIME_DIR}/${WAYLAND_SOCKET}.lock"
  rm -f "${SESSION_STATE_FILE}"
}

session_start_locked() {
  local requested_height requested_refresh requested_scale requested_width

  requested_width="$(sanitize_positive_int "${1:-${DEFAULT_WIDTH}}" "${DEFAULT_WIDTH}" 8192)"
  requested_height="$(sanitize_positive_int "${2:-${DEFAULT_HEIGHT}}" "${DEFAULT_HEIGHT}" 8192)"
  requested_refresh="$(sanitize_refresh_rate "${3:-${DEFAULT_REFRESH_RATE}}" "${DEFAULT_REFRESH_RATE}")"
  requested_scale="$(sanitize_scale_request "${4:-${DEFAULT_SCALE}}" "${DEFAULT_SCALE}")"

  load_session_state >/dev/null 2>&1 || reset_session_vars

  if [ "${DESKTOP_ACTIVE:-0}" = "1" ] && desktop_session_live; then
    log "Desktop session already running at ${WIDTH}x${HEIGHT}@${REFRESH_RATE}."
    return 0
  fi

  set_session_geometry "${requested_width}" "${requested_height}" "${requested_refresh}" "${requested_scale}"
  prepare_session_runtime

  if capture_display_live; then
    configure_xrandr_monitor
    write_kde_session_config
  fi

  if ! capture_display_live || ! x_display_size_matches; then
    log "Restarting capture display for ${WIDTH}x${HEIGHT}@${REFRESH_RATE}."
    stop_display_processes
    if ! start_capture_display; then
      log "Capture display failed to start at ${WIDTH}x${HEIGHT}@${REFRESH_RATE}."
      stop_desktop_runtime
      return 1
    fi
  fi

  if ! x_display_size_matches; then
    log "Capture display is $(current_x_display_size || printf unknown), not requested ${WIDTH}x${HEIGHT}; refusing to start a mismatched stream."
    stop_desktop_runtime
    return 1
  fi

  if ! start_desktop_services; then
    log "Desktop session failed to start at ${WIDTH}x${HEIGHT}@${REFRESH_RATE}."
    stop_desktop_services
    write_session_state
    return 1
  fi

  DESKTOP_ACTIVE=1
  write_session_state
  log "Desktop session started at ${WIDTH}x${HEIGHT}@${REFRESH_RATE} scale ${SCALE} using ${ACTIVE_DISPLAY_DRIVER}."
}

session_start() {
  local status

  acquire_session_lock
  trap release_session_lock EXIT INT TERM

  if session_start_locked "$@"; then
    status=0
  else
    status=$?
  fi

  release_session_lock
  trap - EXIT INT TERM
  return "${status}"
}

session_stop_locked() {
  if load_session_state; then
    log "Stopping desktop session."
    stop_desktop_services
    write_session_state
  else
    reset_session_vars
    rm -f "${SESSION_STATE_FILE}"
    log "Desktop session is already stopped."
  fi
}

session_stop() {
  local status

  acquire_session_lock
  trap release_session_lock EXIT INT TERM

  if session_stop_locked; then
    status=0
  else
    status=$?
  fi

  release_session_lock
  trap - EXIT INT TERM
  return "${status}"
}

client_session_start() {
  local requested_height requested_refresh requested_scale requested_width

  requested_width="${SUNSHINE_CLIENT_WIDTH:-${DEFAULT_WIDTH}}"
  requested_height="${SUNSHINE_CLIENT_HEIGHT:-${DEFAULT_HEIGHT}}"
  requested_refresh="${SUNSHINE_CLIENT_FPS:-${DEFAULT_REFRESH_RATE}}"
  requested_scale="${SUNSHINE_CLIENT_SCALE:-${SUNSHINE_SCALE:-${DEFAULT_SCALE}}}"

  if [ "$(id -u)" -eq 0 ]; then
    exec /usr/local/bin/arch-sunshine session-start "${requested_width}" "${requested_height}" "${requested_refresh}" "${requested_scale}"
  fi

  exec /usr/bin/sudo -n /usr/local/bin/arch-sunshine session-start "${requested_width}" "${requested_height}" "${requested_refresh}" "${requested_scale}"
}

client_session_stop() {
  mkdir -p "${LOG_DIR}" 2>/dev/null || true

  if [ "$(id -u)" -eq 0 ]; then
    setsid -f /usr/local/bin/arch-sunshine session-stop \
      >>"${LOG_DIR}/client-stop.log" 2>&1 </dev/null
    return 0
  fi

  setsid -f /usr/bin/sudo -n /usr/local/bin/arch-sunshine session-stop \
    >>"${LOG_DIR}/client-stop.log" 2>&1 </dev/null
}

disconnect_session() {
  local http_code response response_body

  mkdir -p "${LOG_DIR}" 2>/dev/null || true

  response="$(
    curl -k -sS --connect-timeout 1 --max-time 3 \
      -u "${WEB_UI_USER}:${WEB_UI_PASS}" \
      -H 'Content-Type: application/json' \
      -X POST https://127.0.0.1:47990/api/apps/close \
      --data '{}' \
      -w '\n%{http_code}' 2>&1
  )" || true

  http_code="${response##*$'\n'}"
  response_body="${response%$'\n'*}"
  printf '%s http=%s response=%s\n' "$(date -Is)" "${http_code}" "${response_body}" \
    >>"${LOG_DIR}/disconnect.log" 2>/dev/null || true

  if [ "${http_code}" = "200" ] && printf '%s' "${response_body}" | grep -q '"status"[[:space:]]*:[[:space:]]*true'; then
    return 0
  fi

  client_session_stop
}

shutdown() {
  [ -n "${SUNSHINE_PID:-}" ] && terminate_pid "${SUNSHINE_PID}"
  load_session_state >/dev/null 2>&1 || reset_session_vars
  stop_desktop_runtime
  if mountpoint -q "${HOME_DIR}"; then
    umount "${HOME_DIR}" 2>/dev/null || true
  fi
}

process_status() {
  local pid="${1:-}"

  if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
    printf 'running'
  else
    printf 'stopped'
  fi
}

last_matching_line() {
  local pattern="$1"
  local file="$2"

  if [ -f "${file}" ]; then
    grep -E "${pattern}" "${file}" | tail -n 1 || true
  fi
}

encoder_summary() {
  local file="${LOG_DIR}/sunshine.stdout.log"
  local h264 hevc vendor

  h264="$(last_matching_line 'Found H\.264 encoder' "${file}")"
  hevc="$(last_matching_line 'Found HEVC encoder' "${file}")"
  vendor="$(last_matching_line 'vaapi vendor' "${file}")"

  if [ -n "${h264}" ] || [ -n "${hevc}" ]; then
    printf '%s\n' "${h264##*Info: }"
    printf '%s\n' "${hevc##*Info: }"
  else
    printf 'probing\n'
  fi

  if [ -n "${vendor}" ]; then
    printf '%s\n' "${vendor##*Info: }"
  fi
}

display_log_file() {
  case "${ACTIVE_DISPLAY_DRIVER}" in
    xwayland) printf '%s\n' "${LOG_DIR}/xwayland.log" ;;
    *) printf '%s\n' "${LOG_DIR}/xorg.log" ;;
  esac
}

session_display_status() {
  if load_session_state; then
    if [ "${DESKTOP_ACTIVE:-0}" = "1" ] && desktop_session_live; then
      printf 'running'
      return
    fi
    if capture_display_live; then
      printf 'sleeping'
      return
    fi
  fi

  reset_session_vars
  set_session_geometry "${DEFAULT_WIDTH}" "${DEFAULT_HEIGHT}" "${DEFAULT_REFRESH_RATE}"
  ACTIVE_DISPLAY_DRIVER="${DISPLAY_DRIVER}"
  printf 'stopped'
}

wait_for_key() {
  printf '\nPress any key to return.'
  IFS= read -rsn1 _ || true
}

draw_ui() {
  local display_state

  display_state="$(session_display_status)"

  printf '\033[2J\033[H'
  printf 'Arch Sunshine\n'
  printf '==============\n\n'
  printf 'Status\n'
  printf '  Desktop   %s  KDE Plasma X11 %s on %s %sx%s@%s scale %s\n' "${display_state}" "${ACTIVE_DISPLAY_DRIVER}" "${DISPLAY_NAME}" "${WIDTH}" "${HEIGHT}" "${REFRESH_RATE}" "${SCALE}"
  printf '  Sunshine  %s  https://<host-ip>:47990\n' "$(process_status "${SUNSHINE_PID:-}")"
  printf '  Capture   x11 on %s\n' "${DISPLAY_NAME}"
  printf '  User      %s / %s\n' "${DESKTOP_USER}" "${DESKTOP_USER}"
  printf '  Data      %s\n\n' "${USER_DATA}"
  printf 'Encoder\n'
  encoder_summary | sed 's/^/  /'
  printf '\nLogs\n'
  printf '  Sunshine  %s\n' "${LOG_DIR}/sunshine.log"
  printf '  Xorg      %s\n' "${LOG_DIR}/xorg.log"
  printf '  Weston    %s\n' "${LOG_DIR}/weston.log"
  printf '  Xwayland  %s\n' "${LOG_DIR}/xwayland.log"
  printf '  Plasma    %s\n\n' "${LOG_DIR}/plasma.log"
  printf 'Commands\n'
  printf '  p  pair PIN from Moonlight\n'
  printf '  l  show Sunshine log tail\n'
  printf '  d  show display log tail\n'
  printf '  t  show Steam launch log tail\n'
  printf '  s  open shell as %s\n' "${DESKTOP_USER}"
  printf '  q  quit\n\n'
  printf 'Waiting for command... '
}

show_log_tail() {
  local title="$1"
  local file="$2"

  printf '\033[2J\033[H'
  printf '%s\n' "${title}"
  printf '%s\n\n' "${file}"
  if [ -f "${file}" ]; then
    tail -n 40 "${file}"
  else
    printf 'Log file does not exist yet.\n'
  fi
  wait_for_key
}

pair_device() {
  local body device http_code name pin response response_body

  printf '\033[2J\033[H'
  printf 'Pair Moonlight Device\n'
  printf '=====================\n\n'
  printf 'In Moonlight, choose Arch Sunshine and start pairing first.\n'
  printf 'Then enter the PIN Moonlight shows here.\n\n'
  printf 'Client name (Enter for Moonlight): '
  IFS= read -r device || true
  printf 'PIN (4 digits): '
  IFS= read -r pin || true

  if [[ ! "${pin}" =~ ^[0-9]{4}$ ]]; then
    printf '\nPIN was not submitted: expected exactly 4 digits.\n'
    wait_for_key
    return
  fi

  name="$(printf '%s' "${device:-Moonlight}" | tr -cd '[:alnum:] ._-')"
  if [ -z "${name}" ]; then
    name=Moonlight
  fi
  body="$(printf '{"pin":"%s","name":"%s"}' "${pin}" "${name}")"

  response="$(
    curl -k -sS --connect-timeout 2 --max-time 8 \
      -u "${WEB_UI_USER}:${WEB_UI_PASS}" \
      -H 'Content-Type: application/json' \
      -X POST https://127.0.0.1:47990/api/pin \
      --data "${body}" \
      -w '\n%{http_code}' 2>&1
  )" || true

  http_code="${response##*$'\n'}"
  response_body="${response%$'\n'*}"
  printf '%s device=%s pin-submitted http=%s response=%s\n' \
    "$(date -Is)" "${name}" "${http_code}" "${response_body}" >> "${LOG_DIR}/pair.log"

  if [ "${http_code}" = "200" ] && printf '%s' "${response_body}" | grep -q '"status"[[:space:]]*:[[:space:]]*true'; then
    printf '\nPairing accepted by Sunshine.\n'
  else
    printf '\nPairing was not accepted by Sunshine.\n\n'
    printf '%s\n' "${response_body}"
    printf '\nMake sure Moonlight is actively showing the PIN for Arch Sunshine, not Wolf.\n'
  fi
  wait_for_key
}

open_shell() {
  printf '\033[2J\033[H'
  printf 'Container shell as %s. Password for sudo is %s. Type exit to return.\n\n' "${DESKTOP_USER}" "${DESKTOP_USER}"
  run_as_desktop_user /bin/bash || true
}

run_ui_loop() {
  local key

  while true; do
    if ! kill -0 "${SUNSHINE_PID}" 2>/dev/null; then
      printf '\nSunshine process exited.\n'
      return
    fi

    draw_ui
    IFS= read -rsn1 -t 1 key || key=""
    case "${key}" in
      p|P) pair_device ;;
      l|L) show_log_tail "Sunshine Log" "${LOG_DIR}/sunshine.log" ;;
      d|D) show_log_tail "Display Log" "$(display_log_file)" ;;
      t|T) show_log_tail "Steam Launch Log" "${HOME_DIR}/.local/share/Steam/logs/arch-sunshine-launch.log" ;;
      s|S) open_shell ;;
      q|Q) printf '\nStopping Arch Sunshine.\n'; return ;;
      *) ;;
    esac
  done
}

run_daemon_loop() {
  while true; do
    if ! kill -0 "${SUNSHINE_PID}" 2>/dev/null; then
      log "Sunshine process exited"
      break
    fi
    sleep 1
  done
}

main() {
  reset_session_vars
  trap shutdown INT TERM EXIT
  setup_user_data
  seed_web_credentials
  set_session_geometry "${DEFAULT_WIDTH}" "${DEFAULT_HEIGHT}" "${DEFAULT_REFRESH_RATE}"
  prepare_session_runtime
  start_capture_display || {
    log "X11 capture display failed to start"
    log "Xorg logs: ${LOG_DIR}/xorg.log"
    log "Weston logs: ${LOG_DIR}/weston.log"
    log "Xwayland logs: ${LOG_DIR}/xwayland.log"
    exit 1
  }
  DESKTOP_ACTIVE=0
  write_session_state
  start_sunshine

  log "Arch Sunshine"
  log "Desktop: sleeping until Moonlight starts an app"
  log "Display: X11 capture display ${ACTIVE_DISPLAY_DRIVER} on ${DISPLAY_NAME} (${WIDTH}x${HEIGHT}@${REFRESH_RATE})"
  log "Encoder: Sunshine auto-select"
  log "Sunshine web UI: https://<host-ip>:47990"
  log "Sunshine logs: ${LOG_DIR}/sunshine.log"
  log "Xorg logs: ${LOG_DIR}/xorg.log"
  log "Weston logs: ${LOG_DIR}/weston.log"
  log "Xwayland logs: ${LOG_DIR}/xwayland.log"
  log "Plasma logs: ${LOG_DIR}/plasma.log"

  if [ -t 0 ]; then
    sleep 1
    run_ui_loop
  else
    run_daemon_loop
  fi

  shutdown
  [ -n "${SUNSHINE_PID:-}" ] && wait "${SUNSHINE_PID}" 2>/dev/null || true
  [ -n "${PLASMA_PID:-}" ] && wait "${PLASMA_PID}" 2>/dev/null || true
  [ -n "${XORG_PID:-}" ] && wait "${XORG_PID}" 2>/dev/null || true
  [ -n "${XWAYLAND_PID:-}" ] && wait "${XWAYLAND_PID}" 2>/dev/null || true
  [ -n "${WESTON_PID:-}" ] && wait "${WESTON_PID}" 2>/dev/null || true
}

case "${1:-}" in
  client-start)
    client_session_start
    ;;
  client-stop)
    client_session_stop
    ;;
  disconnect)
    disconnect_session
    ;;
  session-start)
    shift
    session_start "$@"
    ;;
  session-stop)
    session_stop
    ;;
  *)
    main "$@"
    ;;
esac
